DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/db_name
DATABASE_TEST_URL=postgresql+psycopg://user:password@localhost:5432/test_db_name
DATABASE_MIGRATION_TEST_URL=postgresql+psycopg://user:password@localhost:5432/migration_test_db_name

